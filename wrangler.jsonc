{
  // Configuration Cloudflare Workers : site statique (dossier dist) en mode SPA,
  // pour que les adresses comme /clients ou /carte/... ouvrent l'application.
  "name": "beauty-salon",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
